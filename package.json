{
  "name": "js_runtime",
  "private": true,
  "type": "module",
  "description": "Engine-agnostic JavaScript runtime core for jsr widgets",
  "scripts": {
    "test": "node --test",
    "coverage": "npx c8 --reporter=json --reporter=text --include=bootstrap-runtime.js --include=libs/three/three-shim.js node --test",
    "crap": "npx crap4js bootstrap-runtime.js libs/three/three-shim.js --coverage coverage/coverage-final.json --threshold 8.0",
    "engines:host": "bash tool/build_all.sh host"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "c8": "^12.0.0",
    "crap4js": "https://codeload.github.com/vabhzw17eg2qu4m9-bit/crap4js/tar.gz/5556116e37d42df6f3c15c2ff48f5bc353e7a36",
    "esbuild": "0.25.5",
    "playwright": "^1.50.0"
  }
}
